APP_NAME=Laravel
APP_DISPLAY_NAME="داروخانه آنلاین"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:7000
ADMIN_DOMAIN=admin.localhost
APP_PORT=7000
VITE_PORT=5173

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Tehran
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pharmacy
DB_USERNAME=pharmacy
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret
FORWARD_DB_PORT=7070

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_DB=0
REDIS_SESSION_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TALLSTACKUI_PREFIX=ts-

HORIZON_DOMAIN="${ADMIN_DOMAIN}"

# Super admin created by `php artisan db:seed --class=SuperAdminSeeder` (defaults in config/auth.php).
# Set a strong SUPERADMIN_PASSWORD in production; the default one is refused there.
# SUPERADMIN_NAME="مدیر سیستم"
# SUPERADMIN_EMAIL=admin@pharmacy.test
# SUPERADMIN_PASSWORD=

# ---------- Integrations (docs/pharmacy-roadmap.md D11.1) ----------
API_URL="${APP_URL}"

# Tipax
TIPAX_ENABLED=true
TIPAX_BASE_URL=https://omtestapi.tipax.ir
TIPAX_USERNAME=
TIPAX_PASSWORD=
TIPAX_API_KEY=
TIPAX_ORIGIN_ADDRESS_ID=
TIPAX_DEFAULT_PAYMENT_TYPE=50
TIPAX_DEFAULT_PICKUP_TYPE=10
TIPAX_DEFAULT_DISTRIBUTION_TYPE=10
TIPAX_WEBHOOK_SECRET=
TIPAX_TIMEOUT_SECONDS=10
TIPAX_QUOTE_TTL_MINUTES=20
TIPAX_VOLUMETRIC_DIVISOR=5000

# Zarinpal (sandbox accepts any UUID as merchant id)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CURRENCY=IRR
ZARINPAL_CALLBACK_URL="${APP_URL}/payment/zarinpal/callback"
ZARINPAL_TIMEOUT_SECONDS=15
PAYMENT_PENDING_EXPIRY_MINUTES=30

# SMS: Melli Payamak (D11.6). "log" in local/testing, "melipayamak" in staging/production.
SMS_DRIVER=log
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_BASE_URL=https://rest.payamak-panel.com
MELIPAYAMAK_TIMEOUT_SECONDS=8
# bodyIds of the approved patterns
MELIPAYAMAK_PATTERN_OTP=
MELIPAYAMAK_PATTERN_ORDER_PAID=
MELIPAYAMAK_PATTERN_ORDER_SHIPPED=
MELIPAYAMAK_PATTERN_ORDER_OUT_FOR_DELIVERY=
MELIPAYAMAK_PATTERN_ORDER_DELIVERED=
MELIPAYAMAK_PATTERN_PAYMENT_FAILED=
MELIPAYAMAK_PATTERN_STOCK_AVAILABLE=

# Reporting warehouse (D22): separate database, set up in S41
REPORTING_DB_DATABASE=pharmacy_reporting
REPORTING_DB_USERNAME=
REPORTING_DB_PASSWORD=

# Images / CDN
IMAGES_ORIGINALS_DISK=local
IMAGES_VARIANTS_DISK=public                       # "cdn" once S09 adds the CDN disk
IMAGES_CDN_URL=
