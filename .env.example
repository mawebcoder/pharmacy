APP_NAME=Laravel
APP_DISPLAY_NAME=هوتانا
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:7000
APP_FORCE_HTTPS=false
# The admin's own subdomain, e.g. admin.hutana.ir; empty keeps it at /admin.
ADMIN_DOMAIN=
APP_PORT=7000
ADMIN_IDLE_TIMEOUT_MINUTES=30
VITE_PORT=5173

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Tehran
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pharmacy
DB_USERNAME=pharmacy
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret
FORWARD_DB_PORT=7070

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=media                             # images (originals and generated sizes) and page images: media here, s3 in production
IMPORTS_DISK=local                                # uploaded spreadsheets, read on this server
ADMIN_COMMANDS_USER=                              # «فرمان‌ها» runs commands only as this system user (deploy on the server)
QUEUE_CONNECTION=redis
HORIZON_MEMORY_LIMIT=256
# Telescope (/telescope), on unless false. Local records everything; elsewhere only errors, failed or slow (> 2 s) requests,
# failed jobs, slow queries (kept 72 hours), written by a queued job. Super admins with 2FA only.
TELESCOPE_ENABLED=true

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_DB=0
REDIS_SESSION_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# S3-compatible storage of FILESYSTEM_DISK=s3: ArvanCloud's endpoint, path-style URLs, and AWS_URL = the CDN address of the bucket
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TALLSTACKUI_PREFIX=ts-


# Super admin (admin_users) created by `php artisan db:seed` (defaults in config/auth.php); 2FA is set up on first sign-in.
# Set a strong SUPERADMIN_PASSWORD in production; the default one is refused there.
# SUPERADMIN_NAME="مدیر سیستم"
# SUPERADMIN_EMAIL=admin@pharmacy.test
# SUPERADMIN_PASSWORD=

# ---------- Integrations (docs/pharmacy-roadmap.md D11.1) ----------
API_URL="${APP_URL}"

# Tipax
TIPAX_ENABLED=true
TIPAX_BASE_URL=https://omtestapi.tipax.ir
TIPAX_USERNAME=
TIPAX_PASSWORD=
TIPAX_API_KEY=
TIPAX_ORIGIN_ADDRESS_ID=
TIPAX_DEFAULT_PAYMENT_TYPE=10
TIPAX_DEFAULT_PICKUP_TYPE=20
TIPAX_DEFAULT_DISTRIBUTION_TYPE=10
TIPAX_WEBHOOK_SECRET=
TIPAX_TIMEOUT_SECONDS=10
TIPAX_QUOTE_TTL_MINUTES=20
TIPAX_PRICING_TIMEOUT_SECONDS=5
TIPAX_PACKING_ID=504
TIPAX_PACK_TYPE=20
TIPAX_CONTENT_GENERAL_ID=9
TIPAX_CONTENT_LIQUID_ID=1
TIPAX_PRICE_UNIT=rial
TIPAX_PATH_TOKEN=/api/OM/v3/Account/token
TIPAX_PATH_CITIES=/api/OM/v4/Cities/plusstate
TIPAX_PATH_BRANCH_CITIES=/api/OM/v4/Cities/BranchCities
TIPAX_PATH_PRICING=/api/OM/v4/Pricing
TIPAX_PATH_SERVICES_BETWEEN_CITIES=/api/OM/v4/Pricing/GetServicesBetweenCities
TIPAX_PATH_CUSTOMER=/api/OM/v4/Customers
TIPAX_PATH_WALLET=/api/OM/v4/Customers/Wallet
TIPAX_PATH_SERVICES=/api/OM/v4/Pricing/GetServicesList
TIPAX_PATH_PACK_TYPES=/api/OM/v4/PackingType/GetPackTypes
TIPAX_PATH_PACKING_TYPES=/api/OM/v4/PackingType/GetPackingTypes
TIPAX_PATH_PACKAGING_CONTENTS=/api/OM/v4/PackingType/GetPackagingContents
TIPAX_PATH_BRIEF_TRACKING=/api/OM/v4/Tracking/BriefTracking
TIPAX_PATH_REGISTER_ORDER=/api/OM/v4/OmOrder
TIPAX_PATH_CANCEL_PARCEL=/api/OM/v4/Parcels/Cancel
TIPAX_PATH_TRACK_BY_CODES=/api/OM/v4/Tracking/ByTrackingCode
TIPAX_VOLUMETRIC_DIVISOR=5000

# Zarinpal (sandbox accepts any UUID as merchant id)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_BASE_URL=https://payment.zarinpal.com
ZARINPAL_SANDBOX_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_CURRENCY=IRR
ZARINPAL_CALLBACK_URL="${APP_URL}/payment/callback"
ZARINPAL_TIMEOUT_SECONDS=15
PAYMENT_PENDING_EXPIRY_MINUTES=30
# S25: «fake» until Zarinpal (S26). PAYMENT_FAKE_ENABLED must stay false in production.
PAYMENT_GATEWAY=fake
PAYMENT_FAKE_ENABLED=false

# SMS (D11.6): the provider (only "melipayamak" today). SMS_PRETEND=true logs instead of sending (local/testing);
# set it to false in staging/production.
SMS_PROVIDER=melipayamak
SMS_PRETEND=true
# Alert super admins below this credit (rial).
SMS_LOW_CREDIT_BELOW=1000000
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_BASE_URL=https://rest.payamak-panel.com
MELIPAYAMAK_SEND_PATTERN_PATH=/api/SendSMS/BaseServiceNumber
MELIPAYAMAK_CREDIT_PATH=/api/SendSMS/GetCredit
MELIPAYAMAK_CONNECT_TIMEOUT_SECONDS=3
MELIPAYAMAK_TIMEOUT_SECONDS=8
MELIPAYAMAK_RETRIES=3
MELIPAYAMAK_RETRY_SLEEP_MS=300
# bodyIds of the approved patterns
MELIPAYAMAK_PATTERN_OTP=
MELIPAYAMAK_PATTERN_ORDER_PAID=
MELIPAYAMAK_PATTERN_ORDER_SHIPPED=
MELIPAYAMAK_PATTERN_ORDER_OUT_FOR_DELIVERY=
MELIPAYAMAK_PATTERN_ORDER_DELIVERED=
MELIPAYAMAK_PATTERN_PAYMENT_FAILED=
MELIPAYAMAK_PATTERN_STOCK_AVAILABLE=
MELIPAYAMAK_PATTERN_ORDER_CANCELLED=
MELIPAYAMAK_PATTERN_ORDER_PAYMENT_LINK=
MELIPAYAMAK_PATTERN_ORDER_RETURN=
MELIPAYAMAK_PATTERN_RETURN_REQUESTED=
MELIPAYAMAK_PATTERN_REFUND_PAID=

# Reporting warehouse (D22): separate database, set up in S41
REPORTING_DB_DATABASE=pharmacy_reporting
REPORTING_DB_USERNAME=
REPORTING_DB_PASSWORD=

# Search (roadmap D21, decided 2026-11-07 in S12): Meilisearch through Laravel Scout.
# MEILISEARCH_KEY is the master key of the Docker service (any long random string locally).
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Customer sign-in (S17): on APP_ENV=local only, this code signs in any number that just requested one.
OTP_BYPASS_ENABLED=true
OTP_BYPASS_CODE=11111
# Any environment: this one number may also sign in with this code (5 digits) after requesting one. Empty: off.
OTP_FIXED_MOBILE=
OTP_FIXED_CODE=

KAVENEGAR_API_KEY=
KAVENEGAR_BASE_URL=https://api.kavenegar.com
KAVENEGAR_TEMPLATE_ORDER_PAID=
KAVENEGAR_TEMPLATE_ORDER_ON_THE_WAY=
KAVENEGAR_TEMPLATE_ORDER_CANCELLED=
KAVENEGAR_TEMPLATE_ORDER_RETURN=
KAVENEGAR_TEMPLATE_RETURN_REQUESTED=
KAVENEGAR_TEMPLATE_ORDER_PAYMENT_LINK=
KAVENEGAR_TEMPLATE_REFUND_PAID=
KAVENEGAR_TEMPLATE_OTP=
KAVENEGAR_SENDER=
