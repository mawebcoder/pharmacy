[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# Store timestamps in UTC; the app converts to Asia/Tehran for display.
default-time-zone = '+00:00'
max_connections = 200
innodb_buffer_pool_size = 256M
skip-name-resolve
# Index 2-letter Persian words («مو», «لب», «تب») in any FULLTEXT index. Product search uses Meilisearch, not
# MySQL (decided 2026-11-07 in S12); kept on request for ad-hoc full-text queries.
innodb_ft_min_token_size = 2

[client]
default-character-set = utf8mb4
